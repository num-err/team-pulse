# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key (Project Settings -> API). Server-side only; never ship to a browser.
SUPABASE_KEY=your-service-role-key
# Only for projects still on the legacy shared JWT secret (HS256).
# Projects using JWT signing keys are verified via the public JWKS — leave empty.
SUPABASE_JWT_SECRET=

# --- App ------------------------------------------------------------------
APP_ENV=development
# Public base URL of this API; used to build per-workspace webhook URLs.
PUBLIC_API_URL=http://localhost:8001
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
# How often (minutes) the scheduler checks which workspaces are due a digest.
SCHEDULER_TICK_MINUTES=15

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Development-only fallbacks --------------------------------------------
# Per-team Slack / Notion / webhook credentials are stored per workspace
# (Settings -> Integrations in the app). These are only used in development
# for a workspace that hasn't connected its own yet; ignored in production.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
NOTION_TOKEN=
